# --- Secrets ---------------------------------------------------------------
.env
*.token
hf_token*

# --- Données et modèles (ne JAMAIS committer) ------------------------------
# Le corpus source et les modèles entraînés se régénèrent ; ils n'ont rien à
# faire dans git, et leur licence n'est pas forcément celle de ce dépôt.
artifacts/*
!artifacts/.gitkeep
data/*
!data/.gitkeep
!data/seed_rules_ht2gcf.json
*.pt
*.bin
*.arpa
*.pkl
*.jsonl
*.csv
!tests/fixtures/*.csv
# Exception assumée : la feuille de correction de la Phase 1 est un document
# de travail collaboratif, pas un corpus régénérable — le tirage dépend d'une
# graine et l'annotation est manuelle. Contenu : 80 transcriptions issues de
# POTOMITAN/potomitan-gcf-transcription (CC-BY-4.0). L'audio reste exclu.
!data/diagnostic_to_correct.csv
!data/diagnostic_corrected.csv

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- Divers ----------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
wandb/
runs/
