# --- Secrets ---------------------------------------------------------------
.env
*.token
hf_token*

# --- Données et modèles (ne JAMAIS committer) ------------------------------
# Le corpus source et les modèles entraînés se régénèrent ; ils n'ont rien à
# faire dans git, et leur licence n'est pas forcément celle de ce dépôt.
artifacts/*
!artifacts/.gitkeep
data/*
!data/.gitkeep
!data/seed_rules_ht2gcf.json
*.pt
*.bin
*.arpa
*.pkl
*.jsonl
*.csv
!tests/fixtures/*.csv

