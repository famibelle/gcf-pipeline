{
  "schema_version": "1.0",
  "direction": "ht->gcf",
  "meta": {
    "origin": "amorces manuelles",
    "avertissement": "Ces règles sont des HYPOTHÈSES de départ, non validées. Elles servent à pré-remplir la feuille de correction de la Phase 1 pour accélérer le travail humain. Chacune doit être confirmée, corrigée ou rejetée par les données annotées avant d'entrer dans substitution_rules_ht2gcf.json. Le support et la confiance sont volontairement à 0.",
    "reference_orthographique": "GEREC-2 (Guadeloupe)"
  },
  "n_rules": 42,
  "rules": [
    {"src": "ap", "tgt": "ka", "kind": "word", "ngram": 1, "status": "seed", "note": "aspect progressif ht -> gcf"},
    {"src": "a p", "tgt": "ka", "kind": "word", "ngram": 2, "status": "seed", "note": "variante segmentée de Whisper"},
    {"src": "pral", "tgt": "kay", "kind": "word", "ngram": 1, "status": "seed", "note": "prospectif ; concurrence 'ké'"},
    {"src": "prale", "tgt": "kay", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "te", "tgt": "té", "kind": "word", "ngram": 1, "status": "seed", "note": "accompli/antérieur"},
    {"src": "t ap", "tgt": "té ka", "kind": "word", "ngram": 2, "status": "seed", "note": "imparfait progressif"},
    {"src": "tap", "tgt": "té ka", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "se", "tgt": "sé", "kind": "word", "ngram": 1, "status": "seed", "note": "copule + déterminant pluriel gcf"},
    {"src": "ye", "tgt": "yé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "mwen", "tgt": "an", "kind": "word", "ngram": 1, "status": "seed", "note": "CRITIQUE : 'an' seulement en position sujet ; en position objet/possessif le gcf garde 'mwen'. Exige une règle contextuelle après annotation."},
    {"src": "m", "tgt": "an", "kind": "word", "ngram": 1, "status": "seed", "note": "forme clitique sujet"},
    {"src": "li", "tgt": "i", "kind": "word", "ngram": 1, "status": "seed", "note": "sujet 3sg ; objet -> 'i'/'y' selon contexte"},
    {"src": "l", "tgt": "i", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "nan", "tgt": "adan", "kind": "word", "ngram": 1, "status": "seed", "note": "locatif ; concurrence 'an' et 'asi'"},
    {"src": "lan", "tgt": "la", "kind": "word", "ngram": 1, "status": "seed", "note": "déterminant défini postposé"},
    {"src": "nan", "tgt": "la", "kind": "word", "ngram": 1, "status": "seed", "note": "variante allomorphe du défini"},
    {"src": "gen", "tgt": "ni", "kind": "word", "ngram": 1, "status": "seed", "note": "existentiel/possessif"},
    {"src": "genyen", "tgt": "ni", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "ak", "tgt": "é", "kind": "word", "ngram": 1, "status": "seed", "note": "comitatif/coordination"},
    {"src": "avek", "tgt": "èvè", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "avè", "tgt": "èvè", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "epi", "tgt": "épi", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "men", "tgt": "mé", "kind": "word", "ngram": 1, "status": "seed", "note": "conjonction adversative ; ne pas confondre avec 'men' = main"},
    {"src": "paske", "tgt": "padavwa", "kind": "word", "ngram": 1, "status": "seed", "note": "concurrence 'pas'"},
    {"src": "anpil", "tgt": "onlo", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "kay", "tgt": "kaz", "kind": "word", "ngram": 1, "status": "seed", "note": "nom 'maison' ; homographe du prospectif gcf 'kay' -> conflit à arbitrer"},
    {"src": "bagay", "tgt": "biten", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "mesye", "tgt": "misyé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "konnen", "tgt": "konnèt", "kind": "word", "ngram": 1, "status": "seed", "note": "concurrence 'sav'"},
    {"src": "vle", "tgt": "vlé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "ale", "tgt": "alé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "manje", "tgt": "manjé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "pale", "tgt": "palé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "rive", "tgt": "rivé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "gade", "tgt": "gadé", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "chita", "tgt": "chita", "kind": "word", "ngram": 1, "status": "seed", "note": "identique — sert de contrôle négatif"},
    {"src": "kounye a", "tgt": "atchouman", "kind": "word", "ngram": 2, "status": "seed", "note": "TRÈS incertain, plusieurs variantes régionales — à trancher par annotation"},
    {"src": "kijan", "tgt": "ki jan", "kind": "word", "ngram": 1, "status": "seed", "note": "concurrence 'koumandi'"},
    {"src": "poukisa", "tgt": "pouki", "kind": "word", "ngram": 1, "status": "seed", "note": ""},
    {"src": "\\be\\b", "tgt": "é", "kind": "regex", "ngram": 1, "status": "seed", "note": "conjonction 'et' isolée"},
    {"src": "(\\w{2,})e\\b", "tgt": "\\1é", "kind": "regex", "ngram": 1, "status": "seed", "note": "finale verbale -e -> -é. Règle LARGE : à restreindre après diagnostic, elle sur-génère sur les mots grammaticaux."},
    {"src": "\\bou\\s+se\\b", "tgt": "ou sé", "kind": "regex", "ngram": 2, "status": "seed", "note": "garde-fou de désambiguïsation"}
  ]
}
